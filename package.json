{
	"name": "idea-ui",
	"version": "1.0.0",
	"description": "idea-ui - A Vue 3 UI component library",
	"keywords": [
		"vue",
		"vue3",
		"ui",
		"components",
		"idea-ui"
	],
	"main": "dist/idea-ui.umd.js",
	"module": "dist/idea-ui.es.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/idea-ui.es.js",
			"require": "./dist/idea-ui.umd.js"
		},
		"./locale/*": {
			"types": "./dist/locale/*.d.ts",
			"import": "./dist/locale/*.es.js",
			"require": "./dist/locale/*.umd.js",
			"default": "./dist/locale/*.es.js"
		},
		"./dist/*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "npm run build:packages && npm run build:playground",
		"build:packages": "vite build",
		"build:playground": "vite build playground",
		"preview": "vite preview",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
	},
	"peerDependencies": {
		"vue": "^3.3.0"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@vitejs/plugin-vue": "^5.0.0",
		"element-plus": "^2.4.4",
		"highlight.js": "^11.11.1",
		"less": "^4.2.0",
		"typescript": "^5.3.0",
		"vite": "^5.0.0",
		"vite-plugin-dts": "^3.7.0",
		"vue": "^3.3.11",
		"vue-router": "^4.2.5"
	},
	"repository": {
		"type": "git",
		"url": ""
	},
	"author": "",
	"license": "MIT"
}
